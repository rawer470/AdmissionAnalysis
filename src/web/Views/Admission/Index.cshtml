@using WebApp.Models.ViewModels;

<h1>Результат импорта CSV</h1>

<table border="1" cellpadding="6" cellspacing="0">
    <thead>
        <tr>
            <th>Показатель</th>
            <th>Значение</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Удалено</td>
            <td>@Model.Deleted</td>
        </tr>
        <tr>
            <td>Добавлено</td>
            <td>@Model.Inserted</td>
        </tr>
        <tr>
            <td>Обновлено</td>
            <td>@Model.Updated</td>
        </tr>
        <tr>
            <td>Строк в snapshot</td>
            <td>@Model.SnapshotRows</td>
        </tr>
    </tbody>
</table>

<br />

<a asp-action="UploadCsv">Загрузить новые CSV</a>
